         "signer_id": -1,
         "aligned": true,
         "signer_description": "Dos mujeres",
         "screen_position": "multiple"
      },
      {
         "text": "Con lengua de signos, puedo estudiar, puedo crecer, puedo decidir quién quiero ser.",
