         "duration": 4.0,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo corto oscuro",
         "screen_position": "center"
      },
      {
         "text": "Te he pegado porque no me gusta lo que has hecho.",
         "start": 157.2,
         "duration": 3.3,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Mujer pelo largo rubio",
         "screen_position": "center"
      },
      {
         "text": "Si no tienes sexo conmigo, es que no me quieres.",
