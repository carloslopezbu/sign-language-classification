         "duration": 3.5,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Mujer pelo largo rubio",
         "screen_position": "center"
      },
      {
         "text": "Tú te lo gastas en tonterías. El dinero lo guardo yo.",
