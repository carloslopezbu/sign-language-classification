   "annotations": [
      {
         "text": "El 2020 ha sido un año especialmente duro.",
         "start": 5.3,
         "duration": 5.5,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Mujer pelo corto, blusa negra",
         "screen_position": "center"
      },
      {
         "text": "La irrupción de la COVID 19 en nuestras vidas, ha transformado nuestra realidad y nos ha dejado escenas terribles de dolor, angustia, desolación, y soledad.",
         "start": 11.0,
         "duration": 8.8,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Mujer pelo corto, blusa negra",
         "screen_position": "center"
      },
      {
         "text": "Tras la declaración del estado de alarma el 14 marzo, a meses de confinamiento domiciliario,",
         "start": 20.5,
         "duration": 8.0,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Hombre con gafas, camisa granate",
         "screen_position": "center"
      },
      {
         "text": "que agravaron la falta de accesibilidad a la comunicación, a la información",
         "start": 28.8,
         "duration": 5.2,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Hombre con gafas, camisa granate",
         "screen_position": "center"
      },
      {
         "text": "que de por sí afecta a las personas sordas, con todo esto,",
         "start": 34.5,
         "duration": 2.3,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Hombre con gafas, camisa granate",
         "screen_position": "center"
      },
      {
         "text": "y no exentos de incertidumbre, pudimos enfrentarlo con resiliencia.",
         "start": 37.0,
         "duration": 8.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Hombre con gafas, camisa granate",
         "screen_position": "center"
      },
      {
         "text": "La pandemia ha puesto de manifiesto el enorme valor del trabajo en red.",
         "start": 45.8,
         "duration": 7.5,
         "signer_id": 2,
         "aligned": true,
         "signer_description": "Mujer pelo rojo, chaqueta negra",
         "screen_position": "center"
      },
      {
         "text": "Una red que durante un año difícil, ha realizado una ingente labor",
         "start": 53.8,
         "duration": 7.7,
         "signer_id": 2,
         "aligned": true,
         "signer_description": "Mujer pelo rojo, chaqueta negra",
         "screen_position": "center"
      },
      {
         "text": "de incidencia política, de propuestas normativas a favor de las personas sordas.",
