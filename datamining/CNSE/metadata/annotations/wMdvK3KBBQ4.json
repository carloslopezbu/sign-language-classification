         "start": 227.5,
         "duration": 3.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "y no lo olvidemos, en una lengua LEGAL.",
         "start": 231.5,
         "duration": 3.0,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "SOMOS PERSONAS SORDAS.",
         "start": 236.0,
         "duration": 1.8,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "Y no nos asusta, ni nos avergüenza, ni nos incapacita.",
         "start": 238.5,
         "duration": 4.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "No nos exime de nuestros deberes",
         "start": 243.5,
         "duration": 2.5,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "ni resta valor a nuestros derechos.",
         "start": 246.0,
         "duration": 3.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "PERSONAS SORDAS CAPACES de ser lo que queramos ser.",
         "start": 250.0,
         "duration": 4.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "¡Nosotras decidimos!",
         "start": 254.5,
         "duration": 2.5,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "Con audífonos, con implantes cocleares, o sin ellos.",
         "start": 258.0,
         "duration": 3.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "PERSONAS SORDAS que utilizamos la lengua de signos o no.",
         "start": 301.5,
         "duration": 2.5,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "Y no, no nos escondemos.",
         "start": 304.5,
         "duration": 2.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "Y sí, lo queremos todo.",
         "start": 307.0,
         "duration": 2.5,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
