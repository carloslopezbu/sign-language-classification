         "start": 121.5,
         "duration": 3.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "en el plano educativo, lingüístico, político, económico y cultural.",
         "start": 124.5,
         "duration": 3.5,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "Identidad que, sin duda, ha servido para que tanto",
         "start": 128.5,
         "duration": 2.5,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "en la dimensión individual como en la colectiva,",
         "start": 131.0,
         "duration": 3.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
