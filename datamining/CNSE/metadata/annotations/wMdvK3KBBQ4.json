         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "Exigimos que se garantice nuestra LIBERTAD",
         "start": 209.0,
         "duration": 2.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "en el uso de la lengua de signos, porque además de ser la seña",
         "start": 212.0,
         "duration": 3.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "que configura nuestros valores culturales e identitarios,",
         "start": 215.5,
         "duration": 3.0,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "es una lengua de vida que permite el ejercicio",
         "start": 218.5,
         "duration": 2.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "de nuestros derechos en IGUALDAD de condiciones.",
         "start": 221.0,
         "duration": 2.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "Una lengua que a lo largo de generaciones hemos sacado",
         "start": 224.0,
         "duration": 3.0,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
