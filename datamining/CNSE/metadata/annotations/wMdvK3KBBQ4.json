         "duration": 3.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "left"
      },
      {
         "text": "SOMOS PERSONAS SORDAS que unidas en torno a la CNSE,",
         "start": 149.0,
         "duration": 3.0,
