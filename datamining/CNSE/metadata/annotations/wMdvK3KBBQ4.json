   "annotations": [
      {
         "text": "En el Día Internacional de las Personas Sordas",
         "start": 0.0,
         "duration": 3.8,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "center"
      },
      {
         "text": "queremos decirle al mundo quiénes somos y cómo somos",
         "start": 4.2,
         "duration": 3.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "center"
      },
      {
         "text": "para que nuestra realidad deje de ser invisible,",
         "start": 7.5,
         "duration": 3.5,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "center"
      },
      {
         "text": "para que se respeten nuestros derechos,",
         "start": 11.5,
         "duration": 2.5,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "center"
      },
      {
         "text": "y para combatir el desconocimiento,",
         "start": 14.5,
         "duration": 3.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "center"
      },
      {
         "text": "la falta de voluntad o los prejuicios sobre",
         "start": 18.0,
         "duration": 2.8,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "center"
      },
      {
         "text": "nuestro colectivo en general y, sobre las lenguas de signos",
         "start": 21.0,
         "duration": 4.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "center"
      },
      {
         "text": "y quienes las utilizamos.",
         "start": 25.0,
         "duration": 2.0,
         "signer_id": 0,
         "aligned": true,
         "signer_description": "Hombre calvo con polo rojo",
         "screen_position": "center"
      },
      {
         "text": "SOMOS PERSONAS SORDAS, así nos identificamos",
         "start": 29.0,
         "duration": 3.0,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "y así queremos que la sociedad nos reconozca.",
         "start": 32.5,
         "duration": 2.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "Tarea difícil cuando la sordera aún se concibe",
         "start": 36.0,
         "duration": 3.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "como una limitación.",
         "start": 39.8,
         "duration": 1.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "Ni sordomudos ni deficientes auditivos:",
         "start": 42.0,
         "duration": 2.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "PERSONAS SORDAS.",
         "start": 45.0,
         "duration": 2.0,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "Reivindicamos nuestra DIVERSIDAD porque la diversidad,",
         "start": 48.5,
         "duration": 3.0,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "lejos de ser una amenaza, es un factor de progreso.",
         "start": 52.0,
         "duration": 3.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "La diferencia no nos limita; no nos da miedo;",
