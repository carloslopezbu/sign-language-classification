         "duration": 2.0,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "de números o de porcentajes.",
         "start": 105.5,
         "duration": 2.0,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo castaño con blusa negra",
         "screen_position": "left"
      },
      {
         "text": "SOMOS PERSONAS SORDAS que merecemos tener",
