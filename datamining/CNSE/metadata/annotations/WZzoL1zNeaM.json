         "duration": 3.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo liso, chaqueta negra",
         "screen_position": "right"
      },
      {
         "text": "Desde el primer minuto, en cada aviso, en cada rueda de prensa, en cada aplicación.",
