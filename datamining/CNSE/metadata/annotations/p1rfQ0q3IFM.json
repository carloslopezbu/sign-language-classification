         "duration": 3.6,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo liso",
         "screen_position": "right"
      },
      {
         "text": "la capacidad de unir a las personas y derribar barreras.",
         "start": 134.0,
         "duration": 3.5,
         "signer_id": 1,
         "aligned": true,
         "signer_description": "Mujer pelo liso",
         "screen_position": "right"
      },
      {
