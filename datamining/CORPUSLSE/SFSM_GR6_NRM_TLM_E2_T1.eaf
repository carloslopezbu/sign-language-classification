    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="S1_MD_Glosa"/>
    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="S1_MI_Glosa"/>
    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="S2_MD_Glosa"/>
