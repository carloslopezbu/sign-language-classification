    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="Traducción_S2">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a406"
                TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>Yo siendo pequeña,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a407"
                TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts325">
                <ANNOTATION_VALUE>empecé el colegio en Córdoba primero.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a408"
                TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>Esa época la verdad es que no la recuerdo muy bien. Casí nada.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a409"
                TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts377">
                <ANNOTATION_VALUE>A los 7 años empecé en La Purísima de aquí, de Málaga.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a410"
                TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>Allí todos eramos sordos,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a411"
                TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts407">
                <ANNOTATION_VALUE>No había ningún problema de comunicación.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a412"
                TIME_SLOT_REF1="ts408" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>Fue siempre bastante fácil sin ningún problema destacable.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a413"
                TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts435">
                <ANNOTATION_VALUE>También dependía de la capacidad que tuviese cada uno,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414"
                TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>y si para escribir a alguien no se le daba bien,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a415"
                TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>entre todos nos ayudábamos.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a416"
                TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>Los profesores hablaban o signaban.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a417"
                TIME_SLOT_REF1="ts465" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>Algunos los hacían al mismo tiiempo dependiendo de si se lo permitían o no??</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a418"
                TIME_SLOT_REF1="ts504" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>La verdad es que siempre fue bien.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a419"
                TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>Terminé 8º de EGB, de aquella época.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a420"
                TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>Luego empecé en el instituto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a421"
                TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts561">
                <ANNOTATION_VALUE>No contaba con intérprete pero,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a422"
                TIME_SLOT_REF1="ts562" TIME_SLOT_REF2="ts580">
                <ANNOTATION_VALUE>la persona de apoyo que tenía, que era oyente,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a423"
                TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>había trabajado 5 años enseñando a personas sordas,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a424"
                TIME_SLOT_REF1="ts597" TIME_SLOT_REF2="ts612">
                <ANNOTATION_VALUE>de modo que tenía experiencia.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a425"
                TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>En ese momento empezamos a pensar que estar sólo con una persona de apopyo no era lo ideal,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a426"
                TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts648">
                <ANNOTATION_VALUE>y siendo 3 personas sordas juntos conseguiríamos más.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a427"
                TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>Mi madre estuvo luchando porque nos habilitasen un edificio para educación especial???</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a428"
                TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts685">
                <ANNOTATION_VALUE>Y le aprobaron contar con intérprete,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a429"
                TIME_SLOT_REF1="ts686" TIME_SLOT_REF2="ts694">
