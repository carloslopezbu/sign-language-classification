    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="Traducción_S1">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a384"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts13">
                <ANNOTATION_VALUE>De pequeña yo estuve en un colegio de integracion con alumnos oyentes.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a385"
                TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Si aprendí mucho allí o no, creo que no,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a386"
                TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>Pero me sirvió de mucho en cuanto a contacto con la gente. Eso sí estuvo bien.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a387"
                TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Con los profesores tuve muy buena relación también.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a388"
                TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts87">
                <ANNOTATION_VALUE>Lo que signábamos allí era totalmente inventado por nosotros,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a389"
                TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>acordábamos signos y ya está.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a390"
                TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts115">
                <ANNOTATION_VALUE>En cuanto a contenidos educativos no aprendí nada.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a391"
                TIME_SLOT_REF1="ts116" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>Perdía muchísima información.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a392"
                TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts133">
                <ANNOTATION_VALUE>Eran muy permisivos, blandos....</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a393"
                TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>En el exámen nos dejaban tener el libro.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a394"
                TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>En cuanto a contenidos no entendía nada. Perdía todo por completo.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a395"
                TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>No sabía nada.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a396"
                TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>Así fue pasando el tiempo hasta llegar al instituto.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a397"
                TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>Allí ya avancé, iba mejor,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a398"
                TIME_SLOT_REF1="ts224" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>porque allí tenía intérprete.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a399"
                TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts239">
                <ANNOTATION_VALUE>Cierto es que en aquella época no había siempre intérprete y,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a400"
                TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>allí estaba yo sola así que,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a401"
                TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>a la semana puede que tuviese clases de apoyo con ella 2 veces.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a402"
                TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts265">
                <ANNOTATION_VALUE>Realmente era muy poco,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a403"
                TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>no se puede decir que fuese una eduación de calidad pero bueno...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a404"
                TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>La experiencia para mí sí fue positiva.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a405"
                TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>Sobre todo por los compañeros con quién jugaba y disfrutaba.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
