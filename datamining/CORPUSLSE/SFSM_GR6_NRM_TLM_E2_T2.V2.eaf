        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a440"
                TIME_SLOT_REF1="ts819" TIME_SLOT_REF2="ts824">
                <ANNOTATION_VALUE>Los alumnos oyentes en la parte de fuera y,</ANNOTATION_VALUE>
